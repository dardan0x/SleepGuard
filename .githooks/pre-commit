#!/bin/sh
# Pre-commit: auto-format staged Swift files and include the fixes in this commit.
# Applies to every commit tool (Xcode, CLI, editors) since all use git plumbing.
# CI (quality.yml swiftformat job) remains the enforcement backstop.
# Note: NUL-separated output is piped straight to xargs — never stored in a
# shell variable (bash 3.2 strips NUL bytes from command substitution).

count=$(git diff --cached --name-only --diff-filter=ACMR -- '*.swift' | wc -l | tr -d ' ')
[ "$count" -eq 0 ] && exit 0

if ! command -v swiftformat >/dev/null 2>&1; then
  echo "pre-commit: swiftformat not on PATH; skipping (CI enforces lint)" >&2
  exit 0
fi

echo "pre-commit: swiftformat on $count staged Swift file(s)"
git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift' | xargs -0 swiftformat
git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift' | xargs -0 git add --
