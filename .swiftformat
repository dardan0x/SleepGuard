--indent 2
--indentcase false
--trimwhitespace always
--insertlines true
--removelines true
--allman false
--header ignore
--ifdef no-indent
--wraparguments preserve
--wrapparameters preserve
--wrapcollections preserve
--closingparen same-line
--commas always
--maxwidth none
--nospaceoperators ...,..<
--self remove
--importgrouping testable-bottom
--decimalgrouping ignore
--hexgrouping ignore
--binarygrouping ignore
--octalgrouping ignore
--fractiongrouping ignore
--exponentgrouping ignore
--patternlet hoist
--redundanttype infer
--semicolons inline
--shortoptionals always
--stripunusedargs always
--trailingclosures
--yodaconditions preserve
